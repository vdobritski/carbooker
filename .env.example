# Copy to .env and fill in from Supabase: Project Settings -> API.
# Both values are inlined into the client bundle at build time. That is expected for the
# anon key - RLS policies, not secrecy, protect the data. Never put the service role key here.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
